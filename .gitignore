node_modules/
.env*
!.env.example
**/*.log
projects/*/assets/photos/
__pycache__/
library/sfx/raw/
projects/*/out/
projects/*/audio/source.*
projects/*/audio/*.wav
*.tmp
voice-clone/
projects/*/audio/*.mp3
projects/*/audio/_tts/

# shorts from long videos: source media stays local, never pushed (public repo)
shorts/*/source/
shorts/*/clips/
shorts/_titles.json
shorts/_lives.json
shorts/_x-posted/
shorts/*/work/
# (picker.py, gallery.py and variants.py in shorts/casino-wins-in-the-end/work/ stay tracked on purpose: the shorts
# route uses them as the moment-picker tools; their HTML outputs link to local clips and stay local)
source/
# footage shorts: face frames are extracted from the source video, never pushed
projects/*/assets/face/
shorts/*/photos/
# Codex generation logs carry local paths; unused Codex candidates stay local
projects/*/assets/codex/**/*.log
# long-video transcripts (whole video, not just the short) and check frames stay local
shorts/*/transcript.*
.pytest_cache/
tests/.tmp*/

# Projects are local (2026-10-17, workflow review M1): this repo is public, so new videos, scripts and delivery receipts
# never go here. Tracked: the template, the engine demos (no voice, not for posting) and the curated examples/ folder.
# Receipts and the usage log live in Ahmed's private Kanz repo (reports/kanz-motion-deliveries/).
projects/*
!projects/_template/
!projects/_workshop-template/
!projects/_*-demo/
**/delivery.json
examples/*/out/
examples/*/audio/*.wav
examples/*/audio/*.mp3
examples/*/audio/source.*
examples/*/audio/_tts/
examples/*/assets/face/
examples/*/assets/codex/**/*.log
# split-layout half frames are cut from the source video too (SHORT-1)
projects/*/assets/half/
examples/*/assets/half/
.local-render.lock

# motion references are other people's work: local only (REPO-1)
library/references/media/
